{
  "name": "filmpje-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix ../client run dev\" \"tsup src/main.ts src/preload.ts --format cjs --target node18 --out-dir dist --watch\" \"wait-on http://localhost:5173 file:dist/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm --prefix ../client run build && tsup src/main.ts --format cjs --target node18 --out-dir dist && tsup src/preload.ts --format cjs --target node18 --out-dir dist && electron-builder",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.10.2",
    "trash": "^8.1.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "@types/node": "^20.11.30",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.filmpje.app",
    "productName": "Filmpje",
    "files": [
      "dist/**",
      "../client/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/",
        "to": "resources/ffmpeg-static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffprobe-static/",
        "to": "resources/ffprobe-static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}


