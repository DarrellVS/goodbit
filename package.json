{
  "name": "goodbit",
  "productName": "GoodBit",
  "version": "3.6.1",
  "description": "Finds the good bit in your game clips, and keeps it.",
  "author": "Darrell van Swinderen",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "build:streamdeck": "cd streamdeck-plugin && npm ci && npm run check && npx streamdeck validate io.github.darrellvs.goodbit.sdPlugin && npx streamdeck pack io.github.darrellvs.goodbit.sdPlugin --output dist --force",
    "build:win": "npm run check:pre-release && npm run build:streamdeck && electron-builder --win && npm run check:packaged",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test:unit",
    "check:pre-release": "npm run check && npm run test:e2e",
    "test:e2e:packaged": "playwright test",
    "check:packaged": "node scripts/smoke-packaged.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "motion-v": "^2.4.4",
    "reka-ui": "^2.10.4"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.7.7",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.9",
    "electron-vite": "^5.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "floating-vue": "^5.2.2",
    "form-data": "^4.0.0",
    "happy-dom": "^20.14.5",
    "marked": "^18.0.13",
    "multer": "^2.4.0",
    "pinia": "^4.0.3",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue": "^3.5.8",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "typeorm": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
