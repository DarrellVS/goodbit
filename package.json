{
  "name": "goodbit",
  "productName": "GoodBit",
  "version": "1.10.0",
  "description": "Finds the good bit in your game clips, and keeps it.",
  "author": "Darrell van Swinderen",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run check:pre-release && electron-builder --win && npm run check:packaged",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test:unit",
    "check:pre-release": "npm run check && npm run test:e2e",
    "test:e2e:packaged": "playwright test",
    "check:packaged": "node scripts/smoke-packaged.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "reka-ui": "^2.10.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vueuse/core": "^13.9.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "electron-vite": "^2.3.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "express": "^4.19.2",
    "fast-glob": "^3.3.2",
    "floating-vue": "^5.2.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "happy-dom": "^20.14.5",
    "marked": "^13.0.3",
    "multer": "^2.4.0",
    "pinia": "^2.2.4",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.13",
    "typeorm": "^0.3.20",
    "typescript": "^5.6.3",
    "uuid": "^13.0.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7",
    "vue": "^3.5.8",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.2.12"
  }
}
