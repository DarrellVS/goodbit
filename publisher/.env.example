# The publisher's configuration.
#
# Copy this to `.env` and fill it in. That copy is gitignored and must stay
# that way: it holds a secret that can write to a public address and a
# Cloudflare token.
#
# `.env` is read when the publisher runs from source, with `npm run dev` or
# `npm start`. The Docker image takes the same names as environment variables
# instead, and the setup guide writes them into a compose file for you:
# https://darrellvs.github.io/goodbit/publisher.html

# Required. The shared secret GoodBit sends with every upload, as
# `Authorization: Bearer <token>`. Serving clips is public by design; writing
# is not, or anybody who finds the address can fill the disk and host whatever
# they like under your own domain.
#
# With this unset the publisher still starts and still serves everything it
# already has, and refuses every upload with a 503. It says so at boot, in a
# block it is hard to miss, because the version of that which is discovered
# during somebody's upload looks like a broken app rather than a missing
# setting.
#
# Something to paste:  openssl rand -base64 32
PUBLISH_TOKEN=

# Where it listens. 5000 from source; the image sets 5555, which is the port
# the setup guide's compose file and reverse proxy both use.
PORT=5000

# Where clips are written. The image sets /data/public, which is the declared
# volume.
UPLOAD_DIR=./public

# The public HTTPS address, no trailing slash. Every link handed back is built
# from this, so it has to be the address from outside rather than the LAN one.
# Left empty, links are relative and the embed page falls back to the Host
# header it was asked on.
PUBLIC_BASE_URL=

# Optional, both of them, and only useful together. Without them unpublishing
# still deletes the file but a cached copy may serve for a while, and a
# re-published clip may keep the poster frame it had before.
#
# The API token needs exactly one permission: Zone, Cache Purge, Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
